# New shared Express service. People-accounting remains on its own port.
PORT=5230
API_BIND_HOST=127.0.0.1
API_KEYS=
# Existing COMPANY_API_KEY is also accepted in place of API_KEYS.
# Generate one key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PGHOST=YOUR_COMPANY_DATABASE_HOST
PGPORT=5432
PGUSER=YOUR_DATABASE_USER
PGPASSWORD=
PGSSL=false
DOCKFLOW_PGDATABASE=DockFlow
DOCKFLOW_SCHEMA=Analysis
DOCKFLOW_DRESSINGS_TABLE=SAPAnalysisDressings
DOCKFLOW_SAVOURY_TABLE=SAPAnalysisSavoury
POWER_TOOL_PGDATABASE=confirmation_powertool_machine
POWER_TOOL_SCHEMA=power_tool
# Set these when Power Tool uses separate database credentials.
# POWER_TOOL_PGUSER=
# POWER_TOOL_PGPASSWORD=
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000
DOCS_ENABLED=true
TZ=Asia/Manila
