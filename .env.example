# Workstation only. Share the COMPANY_API_KEY with Ubuntu; keep database credentials here.
COMPANY_API_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
UBUNTU_BRIDGE_URL=https://dockflow.myvnc.com/dockflow/api/integrations/company-bridge
COMPANY_DB_HOST=REPLACE_WITH_COMPANY_POSTGRES_HOST
COMPANY_DB_PORT=5432
COMPANY_DB_SSL=false
DOCKFLOW_COMPANY_DB_USER=REPLACE_WITH_DOCKFLOW_DB_USER
DOCKFLOW_COMPANY_DB_PASSWORD=REPLACE_WITH_DOCKFLOW_DB_PASSWORD
POWER_TOOL_COMPANY_DB_USER=REPLACE_WITH_POWER_TOOL_DB_USER
POWER_TOOL_COMPANY_DB_PASSWORD=REPLACE_WITH_POWER_TOOL_DB_PASSWORD

# Names are case sensitive. Defaults match the attached source-table exports.
DOCKFLOW_COMPANY_DB_NAME=DockFlow
DOCKFLOW_COMPANY_DB_SCHEMA=Analysis
DOCKFLOW_COMPANY_DRESSINGS_TABLE=SAPAnalysisDressings
DOCKFLOW_COMPANY_SAVOURY_TABLE=SAPAnalysisSavoury
POWER_TOOL_COMPANY_DB_NAME=confirmation_powertool_machine
POWER_TOOL_COMPANY_DB_SCHEMA=power_tool
